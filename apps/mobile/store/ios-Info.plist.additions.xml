<!--
  APPLIED — these keys are already merged into ios/Runner/Info.plist. This file is kept as the
  reference for what was added and why; re-apply it only if the iOS project is regenerated.

  Permission strings are user-facing — keep them specific and honest (App Store review rejects
  vague descriptions). ITSAppUsesNonExemptEncryption is required, or every upload prompts for
  export-compliance answers.
-->

<key>CFBundleDisplayName</key>
<string>Event Companion</string>

<!-- image_picker: camera capture + library selection (photo upload, profile photo) -->
<key>NSCameraUsageDescription</key>
<string>Used to take and share event photos and your profile picture.</string>
<key>NSPhotoLibraryUsageDescription</key>
<string>Used to choose photos to share to the event gallery and set your profile picture.</string>
<key>NSPhotoLibraryAddUsageDescription</key>
<string>Used to save event photos to your library.</string>

<!-- add_2_calendar: writing agenda/itinerary items to the device calendar -->
<key>NSCalendarsUsageDescription</key>
<string>Used to add event sessions and your itinerary to your calendar.</string>

<!-- url_launcher: tap-to-call/email help contacts and open external maps -->
<key>LSApplicationQueriesSchemes</key>
<array>
  <string>tel</string>
  <string>mailto</string>
  <string>https</string>
  <string>maps</string>
  <string>comgooglemaps</string>
</array>

<!-- The app uses only standard HTTPS/AWS TLS; declare no non-exempt encryption. -->
<key>ITSAppUsesNonExemptEncryption</key>
<false/>
