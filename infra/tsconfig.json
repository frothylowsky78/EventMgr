{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmitOnError": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["bin", "lib"],
  "exclude": ["cdk.out", "node_modules", "dist"]
}
